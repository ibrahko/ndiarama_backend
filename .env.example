# ─────────────────────────────────────────────────────────────────────────────
# NDIARAMA Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer .env dans Git
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-with-a-50-char-random-string

# En développement : 127.0.0.1,localhost
# En production    : ndiarama.com,www.ndiarama.com
ALLOWED_HOSTS=ndiarama.com,www.ndiarama.com

# ── Base de données ───────────────────────────────────────────────────────────
# Développement  : sqlite:///db.sqlite3
# Production     : postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Neon (gratuit) : postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://ndiarama:password@localhost:5432/ndiarama_prod

# ── CORS ──────────────────────────────────────────────────────────────────────
# URLs exactes du frontend (sans slash final)
CORS_ALLOWED_ORIGINS=https://ndiarama.com,https://www.ndiarama.com

# ── Email (notifications formulaire Contact + newsletter) ─────────────────────
DEFAULT_FROM_EMAIL=no-reply@ndiarama.com
CONTACT_EMAIL=contact@ndiarama.com

# SMTP — exemples :
#   SendGrid  : EMAIL_HOST=smtp.sendgrid.net  EMAIL_PORT=587  EMAIL_HOST_USER=apikey  EMAIL_HOST_PASSWORD=SG.xxx
#   Mailjet   : EMAIL_HOST=in-v3.mailjet.com  EMAIL_PORT=587
#   Gmail     : EMAIL_HOST=smtp.gmail.com     EMAIL_PORT=587  (activer "Mot de passe application")
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.votre_cle_sendgrid
EMAIL_USE_TLS=True

# ── Mailchimp (newsletter) ────────────────────────────────────────────────────
MAILCHIMP_API_KEY=votre_cle_mailchimp
MAILCHIMP_LIST_ID=votre_audience_id
MAILCHIMP_SERVER_PREFIX=us16
MAILCHIMP_REPLY_TO=contact@ndiarama.com

# ── Fichiers médias — Cloudinary (OBLIGATOIRE en production Railway) ─────────
# Le disque Railway est éphémère : sans Cloudinary, les images uploadées
# (équipe, épisodes, témoignages) sont perdues à chaque redéploiement.
# Créer un compte gratuit sur cloudinary.com puis copier l'URL depuis le
# Dashboard : Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://123456789:abcdefg@moncloud

# ── CSRF (production) ────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://ndiarama.com,https://www.ndiarama.com

# ── Sécurité HTTPS (production uniquement) ───────────────────────────────────
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True

# ── Monitoring Sentry (optionnel, recommandé) ────────────────────────────────
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
